{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの既定権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://x.com/sese_nagi1125*" },
        { "url": "https://x.com/tw_xkanba*" }
      ]
    },
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://dl.tw-context.dev/*" }]
    }
  ]
}
